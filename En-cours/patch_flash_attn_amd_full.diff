+// NOTE:
+// ggml_metal_device_supports_op() must be defined exactly once in libggml-metal.
+// Keep it in ggml-metal-device.m (ObjC) to avoid a duplicate symbol when both
+// ggml-metal-device.m and ggml-metal-device.cpp are compiled.
+
 diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@
 bool ggml_metal_device_supports_op(ggml_metal_device_t dev, const struct ggml_tensor * op) {
     (void) dev;
 
     switch (op->op) {
+        case GGML_OP_FLASH_ATTN_EXT: {
+            // Supported on AMD too: the Metal implementation does not require simdgroup matrix instructions.
+            // Keep the gate strict enough to avoid hitting asserts in ggml_metal_op_flash_attn_ext().
+            if (op->src[0] == NULL || op->src[1] == NULL || op->src[2] == NULL) {
+                return false;
+            }
+
+            if (op->src[0]->type != GGML_TYPE_F32) {
+                return false;
+            }
+
+            if (op->src[1]->type != op->src[2]->type) {
+                return false;
+            }
+
+            const ggml_type tkv = op->src[1]->type;
+            if (!(tkv == GGML_TYPE_F16 || tkv == GGML_TYPE_BF16 || ggml_is_quantized(tkv))) {
+                return false;
+            }
+
+            // mask must be F16 when present (matches ggml-metal-ops.cpp)
+            if (op->src[3] != NULL && op->src[3]->type != GGML_TYPE_F16) {
+                return false;
+            }
+
+            return true;
+        } break;
+
         default:
             break;
     }
@@
 }
